{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/((?!assets/|src/|node_modules/|@|.*\\.[^/]+$).*)", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/app.js"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "server" } },
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        { "type": "host", "value": "localhost" },
        { "type": "host", "value": "127.0.0.1" },
        { "type": "host", "value": "[::1]" }
      ],
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://apis.google.com; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.firebaseapp.com; frame-src 'self' https://*.firebaseapp.com; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests" }
      ]
    }
  ]
}
