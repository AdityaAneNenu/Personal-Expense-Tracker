# Copy to .env in the project root. Both Vite and the API read this file.
# Firebase Console > Project settings > General > Web app config.
# VITE_FIREBASE_* aliases are also supported for these public fields.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Server only: point to the private service-account JSON. Keep it out of Git.
# Absolute paths or paths relative to the project root work; use forward slashes.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS is also supported, as is Application Default
# Credentials on Google Cloud. Alternatively supply BOTH fields below:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# On Vercel, use FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY as project secrets;
# leave FIREBASE_SERVICE_ACCOUNT_PATH and GOOGLE_APPLICATION_CREDENTIALS unset.
FIREBASE_DATABASE_ID=(default)

PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# On Vercel, leave CLIENT_ORIGIN unset to use the automatic deployment URL.
# Do not copy the localhost value there.
API_PROXY_TARGET=http://127.0.0.1:3001
# Leave empty for Vercel services, the Vite proxy, or the combined production server.
VITE_API_URL=

# Automated tests supply demo-* configuration and local emulator hosts.
# Do not mix a real Firebase project with emulator settings.
